// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./src/client"
}

generator zod {
  provider                  = "zod-prisma-types"
  output                    = "./src/zod"
  createRelationValuesTypes = true
}

datasource db {
  provider = "sqlite"
  //   provider = "postgresql"
}

model User {
  id          Int          @id @default(autoincrement())
  username    String       @unique
  email       String       @unique
  name        String
  password    String
  collections Collection[]
}

model Collection {
  id            String  @id @default(uuid())
  name          String
  /// ID of the list that newly added items are placed into by default
  defaultListId String?
  userId        Int

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists List[]
  items Item[]
}

model List {
  id              String  @id @default(uuid())
  name            String
  /// When true the list cannot be deleted or renamed by the user
  protected       Boolean @default(false)
  backgroundColor String?
  startingRating  Float?
  collectionId    String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  items      Item[]
}

model Item {
  id           Int    @id @default(autoincrement())
  name         String
  description  String
  /// Computed from linked-list position within the list's startingRating
  rating       Float?
  collectionId String
  listId       String

  /// ID of the item that comes immediately before this one in the list (null = head)
  prevId Int? @unique
  /// ID of the item that comes immediately after this one in the list (null = tail)
  nextId Int? @unique

  prev   Item? @relation("LinkedListPrev", fields: [prevId], references: [id], onDelete: SetNull)
  prevOf Item? @relation("LinkedListPrev")
  next   Item? @relation("LinkedListNext", fields: [nextId], references: [id], onDelete: SetNull)
  nextOf Item? @relation("LinkedListNext")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  list       List       @relation(fields: [listId], references: [id], onDelete: Cascade)
}
