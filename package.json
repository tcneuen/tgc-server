{
  "name": "node-express-prisma",
  "version": "1.0.0",
  "description": "Node Backend using ExpressJS & Prisma",
  "main": "index.js",
  "author": "tcneuen",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev-debug": "nodemon --inspect",
    "start": "tsx src/index.ts",
    "db-migrate": "prisma migrate dev",
    "db-seed": "prisma db seed",
    "db-reset": "prisma migrate reset",
    "generate": "prisma generate",
    "generate-cert": "openssl genrsa -out dist/key.pem && openssl req -new -key dist/key.pem -out dist/csr.pem && openssl x509 -req -days 9999 -in dist/csr.pem -signkey dist/key.pem -out dist/cert.pem",
    "create-token": "tsx scripts/create-token.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "zod-prisma-types": "^3.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bcryptjs": "^2.4.3",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.7.8",
    "@types/prettier": "^3",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.0.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.1.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
